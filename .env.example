# Copy to .env for local use. Never commit real secrets.

# Classifier: rules | auto | typesafe
CLASSIFIER_MODE=rules

# Optional TypeSafe API key (official SDK reads TYPESAFE_API_KEY)
TYPESAFE_API_KEY=

# Optional GitHub token for higher search rate limits (read-only sufficient)
GITHUB_TOKEN=

# Feature flags (also in config/runtime.yaml / repo variables)
COLLECTOR_ENABLED=false
AUTO_PR_ENABLED=false
PAGES_ENABLED=false
