{
  "$defs": {
    "ClassifierMode": {
      "enum": [
        "rules",
        "auto",
        "typesafe"
      ],
      "title": "ClassifierMode",
      "type": "string"
    },
    "Disposition": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "created",
            "updated",
            "unchanged",
            "suppressed_rejected",
            "suppressed_merged",
            "duplicate_in_round",
            "security_rejected",
            "pending_review"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "resource_id",
        "disposition"
      ],
      "title": "Disposition",
      "type": "object"
    },
    "QueryCoverage": {
      "additionalProperties": false,
      "properties": {
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "page_size": {
          "default": 0,
          "title": "Page Size",
          "type": "integer"
        },
        "pages_read": {
          "default": 0,
          "title": "Pages Read",
          "type": "integer"
        },
        "items_returned": {
          "default": 0,
          "title": "Items Returned",
          "type": "integer"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Count"
        },
        "incomplete_results": {
          "default": false,
          "title": "Incomplete Results",
          "type": "boolean"
        },
        "execution_status": {
          "default": "success",
          "enum": [
            "success",
            "failed",
            "skipped"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "coverage_status": {
          "default": "unknown",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Coverage Status",
          "type": "string"
        },
        "gap_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Reason"
        }
      },
      "required": [
        "query_id",
        "query"
      ],
      "title": "QueryCoverage",
      "type": "object"
    },
    "SourceResult": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "skipped",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "discovered": {
          "default": 0,
          "title": "Discovered",
          "type": "integer"
        },
        "duplicates": {
          "default": 0,
          "title": "Duplicates",
          "type": "integer"
        },
        "candidates": {
          "default": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "requests": {
          "default": 0,
          "title": "Requests",
          "type": "integer"
        },
        "coverage_gaps": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Gaps",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "time_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Range"
        },
        "execution_status": {
          "anyOf": [
            {
              "enum": [
                "success",
                "failed",
                "skipped"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Status"
        },
        "coverage_status": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "partial",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Status"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/QueryCoverage"
          },
          "title": "Queries",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "title": "SourceResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "classifier": {
      "$ref": "#/$defs/ClassifierMode"
    },
    "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
    },
    "write_local": {
      "title": "Write Local",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceResult"
      },
      "title": "Sources",
      "type": "array"
    },
    "model_calls": {
      "default": 0,
      "title": "Model Calls",
      "type": "integer"
    },
    "overall": {
      "default": "success",
      "enum": [
        "success",
        "degraded",
        "failed"
      ],
      "title": "Overall",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "dispositions": {
      "items": {
        "$ref": "#/$defs/Disposition"
      },
      "title": "Dispositions",
      "type": "array"
    },
    "counts_before": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts Before",
      "type": "object"
    },
    "counts_after": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts After",
      "type": "object"
    },
    "publish_attempted": {
      "default": false,
      "title": "Publish Attempted",
      "type": "boolean"
    },
    "publish_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publish Status"
    },
    "publish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publish Reason"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "mode",
    "classifier",
    "dry_run",
    "write_local"
  ],
  "title": "RunReport",
  "type": "object"
}
